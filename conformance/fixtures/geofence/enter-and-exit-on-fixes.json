{
  "name": "enter-and-exit-on-fixes",
  "description": "Fixes crossing a geofence boundary emit ENTER and EXIT once each.",
  "config": {
    "autoSync": false,
    "stopTimeout": 1
  },
  "steps": [
    {
      "at": 0,
      "input": {
        "type": "addGeofence",
        "id": "g1",
        "dx": 0,
        "dy": 100,
        "radius": 50
      },
      "expect": {
        "result": "ok",
        "geofences": [
          "g1"
        ]
      }
    },
    {
      "at": 1,
      "input": {
        "type": "start"
      },
      "expect": {}
    },
    {
      "at": 2,
      "input": {
        "type": "fix",
        "id": "f1",
        "dx": 0,
        "dy": 0
      },
      "expect": {
        "events": [
          {
            "type": "location",
            "id": "f1"
          }
        ]
      }
    },
    {
      "at": 3,
      "input": {
        "type": "fix",
        "id": "f2",
        "dx": 0,
        "dy": 60
      },
      "expect": {
        "events": [
          {
            "type": "location",
            "id": "f2"
          },
          {
            "type": "geofence",
            "id": "g1",
            "action": "ENTER"
          }
        ]
      }
    },
    {
      "at": 4,
      "input": {
        "type": "fix",
        "id": "f3",
        "dx": 0,
        "dy": 75
      },
      "expect": {
        "events": [
          {
            "type": "location",
            "id": "f3"
          }
        ]
      }
    },
    {
      "at": 5,
      "input": {
        "type": "fix",
        "id": "f4",
        "dx": 0,
        "dy": 200
      },
      "expect": {
        "events": [
          {
            "type": "location",
            "id": "f4"
          },
          {
            "type": "geofence",
            "id": "g1",
            "action": "EXIT"
          }
        ]
      }
    },
    {
      "at": 6,
      "input": {
        "type": "fix",
        "id": "f5",
        "dx": 0,
        "dy": 300
      },
      "expect": {
        "events": [
          {
            "type": "location",
            "id": "f5"
          }
        ]
      }
    }
  ]
}

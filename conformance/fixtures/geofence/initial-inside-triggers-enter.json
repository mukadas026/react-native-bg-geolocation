{
  "name": "initial-inside-triggers-enter",
  "description": "A geofence the device is already inside emits ENTER on the first reading.",
  "config": {
    "autoSync": false,
    "stopTimeout": 1
  },
  "steps": [
    {
      "at": 0,
      "input": {
        "type": "addGeofence",
        "id": "g1",
        "dx": 0,
        "dy": 0,
        "radius": 50
      },
      "expect": {
        "result": "ok"
      }
    },
    {
      "at": 1,
      "input": {
        "type": "start"
      },
      "expect": {}
    },
    {
      "at": 2,
      "input": {
        "type": "fix",
        "id": "f1",
        "dx": 0,
        "dy": 10
      },
      "expect": {
        "events": [
          {
            "type": "location",
            "id": "f1"
          },
          {
            "type": "geofence",
            "id": "g1",
            "action": "ENTER"
          }
        ]
      }
    }
  ]
}

{
  "name": "state-persists-across-restart",
  "description": "A restart keeps the registry and inside state, so ENTER is not repeated.",
  "config": {
    "autoSync": false,
    "stopTimeout": 1
  },
  "steps": [
    {
      "at": 0,
      "input": {
        "type": "addGeofence",
        "id": "g1",
        "dx": 0,
        "dy": 0,
        "radius": 50
      },
      "expect": {
        "result": "ok"
      }
    },
    {
      "at": 1,
      "input": {
        "type": "start"
      },
      "expect": {}
    },
    {
      "at": 2,
      "input": {
        "type": "fix",
        "id": "f1",
        "dx": 0,
        "dy": 0
      },
      "expect": {
        "events": [
          {
            "type": "location",
            "id": "f1"
          },
          {
            "type": "geofence",
            "id": "g1",
            "action": "ENTER"
          }
        ]
      }
    },
    {
      "at": 3,
      "input": {
        "type": "restart"
      },
      "expect": {
        "geofences": [
          "g1"
        ],
        "events": []
      }
    },
    {
      "at": 4,
      "input": {
        "type": "fix",
        "id": "f2",
        "dx": 0,
        "dy": 5
      },
      "expect": {
        "events": [
          {
            "type": "location",
            "id": "f2"
          }
        ]
      }
    },
    {
      "at": 5,
      "input": {
        "type": "fix",
        "id": "f3",
        "dx": 0,
        "dy": 300
      },
      "expect": {
        "events": [
          {
            "type": "location",
            "id": "f3"
          },
          {
            "type": "geofence",
            "id": "g1",
            "action": "EXIT"
          }
        ]
      }
    }
  ]
}

{
  "name": "outside-first-reading-is-silent",
  "description": "A first reading outside a geofence emits nothing and does not later produce a spurious EXIT.",
  "config": {
    "autoSync": false,
    "stopTimeout": 1
  },
  "steps": [
    {
      "at": 0,
      "input": {
        "type": "addGeofence",
        "id": "g1",
        "dx": 0,
        "dy": 500,
        "radius": 50
      },
      "expect": {
        "result": "ok"
      }
    },
    {
      "at": 1,
      "input": {
        "type": "start"
      },
      "expect": {}
    },
    {
      "at": 2,
      "input": {
        "type": "fix",
        "id": "f1",
        "dx": 0,
        "dy": 0
      },
      "expect": {
        "events": [
          {
            "type": "location",
            "id": "f1"
          }
        ]
      }
    },
    {
      "at": 3,
      "input": {
        "type": "fix",
        "id": "f2",
        "dx": 0,
        "dy": 100
      },
      "expect": {
        "events": [
          {
            "type": "location",
            "id": "f2"
          }
        ]
      }
    }
  ]
}

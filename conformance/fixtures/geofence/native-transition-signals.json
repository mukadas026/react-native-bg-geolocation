{
  "name": "native-transition-signals",
  "description": "Native ENTER and EXIT signals set state and emit once, and repeated signals are ignored.",
  "config": {
    "autoSync": false,
    "stopTimeout": 1
  },
  "steps": [
    {
      "at": 0,
      "input": {
        "type": "addGeofence",
        "id": "g1",
        "dx": 0,
        "dy": 0,
        "radius": 50
      },
      "expect": {
        "result": "ok"
      }
    },
    {
      "at": 1,
      "input": {
        "type": "start"
      },
      "expect": {}
    },
    {
      "at": 2,
      "input": {
        "type": "geofenceTransition",
        "id": "g1",
        "action": "ENTER"
      },
      "expect": {
        "events": [
          {
            "type": "geofence",
            "id": "g1",
            "action": "ENTER"
          }
        ]
      }
    },
    {
      "at": 3,
      "input": {
        "type": "geofenceTransition",
        "id": "g1",
        "action": "ENTER"
      },
      "expect": {
        "events": []
      }
    },
    {
      "at": 4,
      "input": {
        "type": "geofenceTransition",
        "id": "g1",
        "action": "EXIT"
      },
      "expect": {
        "events": [
          {
            "type": "geofence",
            "id": "g1",
            "action": "EXIT"
          }
        ]
      }
    },
    {
      "at": 5,
      "input": {
        "type": "geofenceTransition",
        "id": "g1",
        "action": "EXIT"
      },
      "expect": {
        "events": []
      }
    },
    {
      "at": 6,
      "input": {
        "type": "geofenceTransition",
        "id": "missing",
        "action": "ENTER"
      },
      "expect": {
        "events": []
      }
    }
  ]
}

{
  "name": "fix-not-recorded-still-evaluated",
  "description": "A fix inside distanceFilter is not recorded but still triggers geofence events.",
  "config": {
    "autoSync": false,
    "stopTimeout": 1
  },
  "steps": [
    {
      "at": 0,
      "input": {
        "type": "addGeofence",
        "id": "g1",
        "dx": 0,
        "dy": 30,
        "radius": 25
      },
      "expect": {
        "result": "ok"
      }
    },
    {
      "at": 1,
      "input": {
        "type": "start"
      },
      "expect": {}
    },
    {
      "at": 2,
      "input": {
        "type": "fix",
        "id": "f1",
        "dx": 0,
        "dy": 0
      },
      "expect": {
        "events": [
          {
            "type": "location",
            "id": "f1"
          }
        ],
        "buffer": [
          "f1"
        ]
      }
    },
    {
      "at": 3,
      "input": {
        "type": "fix",
        "id": "f2",
        "dx": 0,
        "dy": 8
      },
      "expect": {
        "events": [
          {
            "type": "geofence",
            "id": "g1",
            "action": "ENTER"
          }
        ],
        "buffer": [
          "f1"
        ]
      }
    }
  ]
}

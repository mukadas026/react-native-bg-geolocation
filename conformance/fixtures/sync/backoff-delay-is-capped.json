{
  "name": "backoff-delay-is-capped",
  "description": "The retry delay never exceeds syncRetryMaxDelay.",
  "config": {
    "syncRetryBaseDelay": 10,
    "syncRetryMaxDelay": 20
  },
  "server": [
    500,
    500,
    500,
    500,
    200
  ],
  "steps": [
    {
      "at": 0,
      "input": {
        "type": "start"
      },
      "expect": {}
    },
    {
      "at": 1,
      "input": {
        "type": "fix",
        "id": "f1",
        "dx": 0,
        "dy": 0
      },
      "expect": {
        "requests": [
          [
            "f1"
          ]
        ]
      }
    },
    {

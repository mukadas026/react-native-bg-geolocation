        "type": "tick"
      },
      "expect": {
        "requests": [
          [
            "f1"
          ]
        ]
      }
    },
    {
      "at": 31,
      "input": {
        "type": "tick"
      },
      "expect": {
        "requests": [
          [
            "f1"
          ]
        ]
      }
    },
    {
      "at": 51,
      "input": {
        "type": "tick"
      },
      "expect": {
        "requests": [
          [
            "f1"
          ]
        ]
      }
    },
    {
      "at": 70,
      "input": {
        "type": "tick"
      },
      "expect": {
        "requests": []
      }
    },
    {
      "at": 71,
      "input": {
        "type": "tick"
      },
      "expect": {
        "requests": [
          [
            "f1"
          ]
        ],
        "buffer": []
      }

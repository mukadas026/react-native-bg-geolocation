{
  "name": "motion-signal-ignored-while-moving",
  "description": "Motion signals only matter while stationary.",
  "config": {
    "autoSync": false,
    "stopTimeout": 1
  },
  "steps": [
    {
      "at": 0,
      "input": {
        "type": "start"
      },
      "expect": {}
    },
    {
      "at": 1,
      "input": {
        "type": "fix",
        "id": "f1",
        "dx": 0,
        "dy": 0
      },
      "expect": {
        "events": [
          {
            "type": "location",
            "id": "f1"
          }
        ]
      }
    },
    {
      "at": 2,
      "input": {
        "type": "motionSignal"
      },
      "expect": {
        "state": "moving",
        "engine": "continuous",
        "events": []
      }
    }
  ]
}

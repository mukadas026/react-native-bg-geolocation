{
  "name": "fixes-ignored-while-stationary",
  "description": "While stationary, fixes neither record nor change state.",
  "config": {
    "autoSync": false,
    "stopTimeout": 1
  },
  "steps": [
    {
      "at": 0,
      "input": {
        "type": "start"
      },
      "expect": {}
    },
    {
      "at": 1,
      "input": {
        "type": "fix",
        "id": "f1",
        "dx": 0,
        "dy": 0
      },
      "expect": {
        "events": [
          {
            "type": "location",
            "id": "f1"
          }
        ]
      }
    },
    {
      "at": 61,
      "input": {
        "type": "tick"
      },
      "expect": {
        "state": "stationary",
        "events": [
          {
            "type": "motionchange",
            "isMoving": false
          }
        ]
      }
    },
    {
      "at": 200,
      "input": {
        "type": "fix",
        "id": "f2",
        "dx": 0,
        "dy": 500
      },
      "expect": {
        "events": [],
        "state": "stationary",
        "buffer": [
          "f1"
        ]
      }
    }
  ]
}

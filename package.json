{
  "name": "react-native-bg-geolocation",
  "version": "0.1.0",
  "description": "Background geolocation for React Native with Play Services-free Android support",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-bg-geolocation-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "app.plugin.js",
    "plugin",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!plugin/src",
    "!plugin/tsconfig.json",
    "!ios/Core/Tests",
    "!ios/Core/.swiftpm",
    "!ios/Core/.build",
    "!android/core-tests",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-bg-geolocation-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build && tsc -p plugin",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test:conformance": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test conformance/reference/conformance.test.ts",
    "test:kotlin": "./example/android/gradlew -p android/core-tests test --console=plain",
    "test:swift": "swift test --package-path ios/Core",
    "test:cores": "yarn test:conformance && yarn test:kotlin && yarn test:swift",
    "build:plugin": "tsc -p plugin",
    "test:plugin": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test plugin/src/index.test.ts"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mukadas026/react-native-bg-geolocation.git"
  },
  "author": "mukadas <mukadasm026@gmail.com> (https://github.com/mukadas026)",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/mukadas026/react-native-bg-geolocation/issues"
  },
  "homepage": "https://github.com/mukadas026/react-native-bg-geolocation#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@expo/config-plugins": "^57.0.9",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-builder-bob": "^0.43.2",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@expo/config-plugins": "*",
    "react": "*",
    "react-native": "*"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "BgGeolocationSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.bggeolocation"
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "tools": [
      "eslint"
    ],
    "version": "0.63.1"
  },
  "peerDependenciesMeta": {
    "@expo/config-plugins": {
      "optional": true
    }
  }
}
